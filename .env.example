# URL pública do site (usada em canonical, sitemap, Open Graph e hreflang).
NEXT_PUBLIC_SITE_URL=https://seudominio.com

# Formulário de contato (opcional). Sem RESEND_API_KEY e CONTACT_TO_EMAIL,
# o formulário aparece desabilitado com um aviso. Nunca use o prefixo NEXT_PUBLIC_ aqui.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remetente de um domínio verificado no Resend (padrão: onboarding@resend.dev, só para testes).
CONTACT_FROM_EMAIL=
